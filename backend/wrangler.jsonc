{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "unitutor-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "FRONTEND_ORIGIN": "https://unitutor.askwho.net"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "unitutor",
      "database_id": "7bc6be4d-4809-4faa-9f38-4a9d7973b6be",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "api.tutor.askwho.net",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
